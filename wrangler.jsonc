{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-reset-alarm",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [
    { "binding": "STATE", "id": "YOUR_KV_NAMESPACE_ID" }
  ]
}
